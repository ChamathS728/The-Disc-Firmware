void DRV_sleep(stepperHandle_t* sHandlePtr) {
	// Pull sleep pin low to sleep the device
	HAL_GPIO_WritePin(sHandlePtr->IO->nSleepPort, sHandlePtr->IO->nSleepPin, GPIO_PIN_RESET);
}
